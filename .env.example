# Required for signed guest/account sessions (32+ characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required only for email accounts and account-based quota
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=wine_ai
DB_SSL=false

# Optional: comma-separated deployed origins; same-origin deployment can leave empty
ALLOWED_ORIGINS=

# Optional API protection token (not exposed to frontend). JWT sessions are also accepted.
API_KEY=replace-with-a-long-random-secret
REQUEST_TIMEOUT=25000
PORT=3000
